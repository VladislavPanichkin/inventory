# Copy to backend/.env and adjust. Never commit the real .env file.

NODE_ENV=development
PORT=3000
# Public URL of the admin frontend (CORS origin + OAuth redirects back to the UI).
FRONTEND_URL=http://localhost:5173

# --- Database (matches docker-compose.yml defaults) ---
DATABASE_URL=postgresql://inventory:inventory@localhost:5432/inventory
# Separate database used by integration tests (created by docker/postgres-init).
TEST_DATABASE_URL=postgresql://inventory:inventory@localhost:5432/inventory_test

# --- Inventory defaults ---
DEFAULT_CURRENCY=EUR

# --- Administrator (used by the seed script to create the single admin) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# --- Demo account (optional) ---
# A second, restricted login for showing the app to others. It has its own sample items
# (restored at every sign-in), no eBay access, and at most DEMO_CHANGE_LIMIT changes per sign-in.
# Set both to switch it on (password: at least 12 characters, and a different email than the
# administrator's). Remove them and restart to delete the account and its data.
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_CHANGE_LIMIT=5

# --- Secrets ---
# 32-byte key, base64. Encrypts eBay refresh/access tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- Product photos ---
# Leave everything empty in development: photos go to backend/.data/images (gitignored).
# Production needs an S3-compatible bucket (Railway Bucket, Cloudflare R2, AWS S3…).
# IMAGE_STORAGE=s3|local   (default: s3 when all S3_* are set, otherwise local)
IMAGE_STORAGE=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- eBay (Phase 3+). Leave empty until you have developer credentials. ---
EBAY_ENVIRONMENT=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# eBay "RuName" (redirect URL name) from the developer portal, not a raw URL.
EBAY_RU_NAME=
EBAY_MARKETPLACE_ID=EBAY_DE
# Optional: OAuth scopes requested at consent, space-separated. Default:
#   https://api.ebay.com/oauth/api_scope https://api.ebay.com/oauth/api_scope/sell.fulfillment
# EBAY_SCOPES=
# Verification token for eBay's marketplace-account-deletion endpoint
# (/api/v1/webhooks/ebay/account-deletion). 32-80 chars of letters, digits, _ and -.
# Only needed for a production keyset; the endpoint is off while this is empty.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EBAY_VERIFICATION_TOKEN=
