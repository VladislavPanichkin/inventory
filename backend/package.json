{
  "name": "@inventory/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "admin:set-password": "tsx --env-file-if-exists=.env scripts/set-admin-password.ts",
    "storage:check": "tsx scripts/check-image-storage.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@hono/swagger-ui": "0.6.2",
    "@hono/zod-openapi": "1.6.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "aws4fetch": "1.0.20",
    "hash-wasm": "4.12.0",
    "hono": "4.13.17",
    "prisma": "7.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
