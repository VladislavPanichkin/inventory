// Inventory management + eBay synchronization schema.
//
// Conventions:
// - UUID primary keys (generated by Prisma, so they work the same on any Postgres host).
// - Model names are PascalCase; tables are snake_case plural via @@map.
// - Money is Decimal(12, 2); currency is an ISO 4217 code.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  // Pinned explicitly (otherwise inferred from tsconfig.json, which isn't present in every
  // build context, e.g. the Docker dependency layer): ESM, .ts sources importing ".js".
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// ADMIN = the owner of the app. DEMO = the restricted showcase account: its own sample
/// items, no eBay access, and a limited number of changes.
enum UserRole {
  ADMIN
  DEMO
}

enum ProductStatus {
  AVAILABLE
  RESERVED
  SOLD
  ARCHIVED
}

/// Who/what caused a product status change. Used to honour manual corrections.
enum StatusChangeSource {
  MANUAL
  EBAY_ORDER
  EBAY_CANCELLATION
  IMPORT
  SYSTEM
}

enum ListingStatus {
  ACTIVE
  ENDED
  UNKNOWN
}

enum SaleStatus {
  CONFIRMED
  CANCELLED
}

enum NotificationProcessingStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum EbayConnectionStatus {
  CONNECTED
  DISCONNECTED
  /// Refresh token revoked/expired; the admin must reconnect.
  REAUTH_REQUIRED
}

/// Things that need a human decision instead of an automatic status change.
enum ReconciliationIssueType {
  /// An order line item references an eBay item that is not mapped to a product.
  UNMATCHED_LINE_ITEM
  /// A sale was cancelled; the admin decides whether the item is available again.
  SALE_CANCELLED
  /// An automatic update conflicted with a manually set status.
  STATUS_CONFLICT
  /// The same product appears in more than one confirmed sale.
  DUPLICATE_SALE_FOR_PRODUCT
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

/// One row = one unique physical item (quantity is always 1).
model Product {
  id          String        @id @default(uuid()) @db.Uuid
  /// The account this item belongs to. Every query is limited to the signed-in account's items.
  ownerId     String        @db.Uuid
  name        String
  description String?
  price       Decimal       @db.Decimal(12, 2)
  currency    String        @db.Char(3)
  condition   String?
  status      ProductStatus @default(AVAILABLE)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  owner         AdminUser             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  listing       EbayListing?
  sales         Sale[]
  statusChanges ProductStatusChange[]
  issues        ReconciliationIssue[]
  images        ProductImage[]

  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
  @@index([name])
  @@map("products")
}

/// An uploaded product photo. The files live in object storage (S3-compatible bucket in
/// production, a local folder in development); this row holds their keys and metadata.
/// The image with the lowest position is the product's main photo.
model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @db.Uuid
  /// Object key of the full-size JPEG (longest side <= 2048 px).
  storageKey String   @unique
  /// Object key of the thumbnail JPEG (longest side <= 600 px) used in lists.
  thumbKey   String   @unique
  width      Int
  height     Int
  sizeBytes  Int
  position   Int
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

/// Append-only audit trail of every product status transition.
model ProductStatusChange {
  id         String             @id @default(uuid()) @db.Uuid
  productId  String             @db.Uuid
  fromStatus ProductStatus?
  toStatus   ProductStatus
  source     StatusChangeSource
  reason     String?
  saleId     String?            @db.Uuid
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale    Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@map("product_status_changes")
}

// ---------------------------------------------------------------------------
// eBay
// ---------------------------------------------------------------------------

/// Mapping between an internal product and an existing eBay listing.
model EbayListing {
  id            String        @id @default(uuid()) @db.Uuid
  /// Unique: one eBay listing per product in the initial version.
  productId     String        @unique @db.Uuid
  /// eBay legacy item ID. eBay item IDs are globally unique, so a global unique
  /// constraint (stricter than per-marketplace) keeps order matching unambiguous.
  ebayItemId    String        @unique
  marketplaceId String
  /// Listing title snapshot from eBay (used by the import wizard and for audits).
  title         String?
  listingStatus ListingStatus @default(UNKNOWN)
  listingUrl    String?
  /// eBay's own picture of the listing (hosted by eBay). Shown until the product has its own photos.
  imageUrl      String?
  lastSyncedAt  DateTime?     @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("ebay_listings")
}

/// The single connected eBay seller account. Tokens are stored encrypted and are
/// never returned by any API endpoint.
model EbayAccount {
  id                    String               @id @default(uuid()) @db.Uuid
  sellerUsername        String?
  marketplaceId         String
  connectionStatus      EbayConnectionStatus @default(DISCONNECTED)
  refreshTokenEncrypted String?
  refreshTokenExpiresAt DateTime?            @db.Timestamptz(3)
  /// Cached access token (encrypted) so we don't refresh on every request.
  accessTokenEncrypted  String?
  accessTokenExpiresAt  DateTime?            @db.Timestamptz(3)
  scopes                String?
  lastErrorMessage      String?
  connectedAt           DateTime?            @db.Timestamptz(3)
  createdAt             DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(3)

  @@map("ebay_accounts")
}

/// Single-use OAuth `state` values for CSRF protection of the authorization flow.
/// Bound to the admin session that started the flow: the callback must arrive in that same session.
model OAuthState {
  id             String    @id @default(uuid()) @db.Uuid
  state          String    @unique
  adminSessionId String    @db.Uuid
  expiresAt      DateTime  @db.Timestamptz(3)
  usedAt         DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  adminSession AdminSession @relation(fields: [adminSessionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("oauth_states")
}

// ---------------------------------------------------------------------------
// Sales
// ---------------------------------------------------------------------------

model Sale {
  id                 String     @id @default(uuid()) @db.Uuid
  productId          String     @db.Uuid
  ebayOrderId        String
  ebayLineItemId     String
  /// legacyItemId from the order line item, kept for audit.
  ebayItemId         String?
  quantity           Int        @default(1)
  soldPrice          Decimal    @db.Decimal(12, 2)
  currency           String     @db.Char(3)
  soldAt             DateTime   @db.Timestamptz(3)
  saleStatus         SaleStatus @default(CONFIRMED)
  /// eBay's lastModifiedDate for the order; used to detect later modifications.
  ebayLastModifiedAt DateTime?  @db.Timestamptz(3)
  cancelledAt        DateTime?  @db.Timestamptz(3)
  cancellationReason String?
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)

  /// Restrict: a product with sales history can never be hard-deleted.
  product       Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  statusChanges ProductStatusChange[]

  /// Prevents duplicate sales for the same eBay order line item.
  @@unique([ebayOrderId, ebayLineItemId])
  @@index([productId])
  @@index([soldAt])
  @@index([saleStatus])
  @@map("sales")
}

// ---------------------------------------------------------------------------
// Webhooks & synchronization
// ---------------------------------------------------------------------------

/// Raw, signature-verified eBay notifications. Doubles as the durable work queue
/// for asynchronous processing and retries.
model EbayNotification {
  id               String                       @id @default(uuid()) @db.Uuid
  /// eBay's notificationId. Unique, so redelivered notifications are stored once.
  notificationId   String?                      @unique
  topic            String
  payload          Json
  receivedAt       DateTime                     @default(now()) @db.Timestamptz(3)
  processedAt      DateTime?                    @db.Timestamptz(3)
  processingStatus NotificationProcessingStatus @default(PENDING)
  errorMessage     String?
  attempts         Int                          @default(0)
  nextAttemptAt    DateTime?                    @db.Timestamptz(3)
  /// Set while a worker holds the item; stale locks are reclaimed.
  lockedAt         DateTime?                    @db.Timestamptz(3)

  @@index([processingStatus, nextAttemptAt])
  @@index([receivedAt])
  @@map("ebay_notifications")
}

model SyncLog {
  id               String     @id @default(uuid()) @db.Uuid
  syncType         String
  status           SyncStatus @default(RUNNING)
  startedAt        DateTime   @default(now()) @db.Timestamptz(3)
  completedAt      DateTime?  @db.Timestamptz(3)
  recordsProcessed Int        @default(0)
  errorMessage     String?
  metadata         Json?

  @@index([syncType, startedAt])
  @@index([status, startedAt])
  @@map("sync_logs")
}

/// Per-job cursor (e.g. last order modification time seen) plus a lease so two
/// processes never run the same scheduled job concurrently.
model SyncCheckpoint {
  name        String    @id
  cursor      DateTime? @db.Timestamptz(3)
  metadata    Json?
  lockedUntil DateTime? @db.Timestamptz(3)
  lockOwner   String?
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@map("sync_checkpoints")
}

/// Queue of situations requiring a human decision (unmatched listings,
/// cancellations, conflicts). Never auto-resolved by changing product status.
model ReconciliationIssue {
  id             String                  @id @default(uuid()) @db.Uuid
  type           ReconciliationIssueType
  productId      String?                 @db.Uuid
  ebayOrderId    String?
  ebayLineItemId String?
  ebayItemId     String?
  message        String
  details        Json?
  resolvedAt     DateTime?               @db.Timestamptz(3)
  resolutionNote String?
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(3)

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// One issue per (type, order line item): repeated syncs don't create duplicates.
  @@unique([type, ebayOrderId, ebayLineItemId])
  @@index([resolvedAt, createdAt])
  @@map("reconciliation_issues")
}

// ---------------------------------------------------------------------------
// Authentication (one administrator, plus an optional demo account)
// ---------------------------------------------------------------------------

model AdminUser {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique
  passwordHash    String
  role            UserRole @default(ADMIN)
  /// Changes the demo account has made since its sample data was last restored (0 for the administrator).
  demoChangesUsed Int      @default(0)
  /// When the demo visitor connected the simulated eBay account (null = not connected; cleared at every demo sign-in).
  demoEbayConnectedAt DateTime? @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  sessions AdminSession[]
  products Product[]

  @@map("admin_users")
}

/// Server-side sessions. Only a SHA-256 hash of the session token is stored.
model AdminSession {
  id          String   @id @default(uuid()) @db.Uuid
  tokenHash   String   @unique
  adminUserId String   @db.Uuid
  expiresAt   DateTime @db.Timestamptz(3)
  lastSeenAt  DateTime @default(now()) @db.Timestamptz(3)
  userAgent   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  adminUser   AdminUser    @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  oauthStates OAuthState[]

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_sessions")
}
